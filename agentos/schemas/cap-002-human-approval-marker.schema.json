{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAP-002 Human Approval Marker",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "DEFERRED", "PENDING"]
    },
    "actor_type": {
      "type": "string",
      "enum": ["human"]
    },
    "selected_by_human": {
      "type": "boolean",
      "const": true
    },
    "human_decision_reference": {
      "type": "string"
    },
    "agent_generated": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "approval_id",
    "task_id",
    "capability_id",
    "decision",
    "actor_type",
    "selected_by_human",
    "human_decision_reference",
    "agent_generated"
  ],
  "additionalProperties": false,
  "description": "The schema must require at minimum the fields listed. actor_type must be human. selected_by_human must be true. agent_generated must be false. decision must be one of APPROVED, REJECTED, DEFERRED, PENDING. Only APPROVED may allow the next gate. REJECTED, DEFERRED, and PENDING must block. The schema must not itself create approval."
}
